{
  "title": "ஸ்ரீ விநாயகர் அஷ்டோத்தர சத நாமாவளி",
  "language": "Tamil",
  "count": 108,
  "names": [
    { "id": 1, "name": "ஓம் விநாயகாய நம:", "meaning": "மேலான தலைவர் இல்லாதவரே (தனக்கு மேல் தலைவன் இல்லாத தனிப்பெரும் தலைவரே) போற்றி" },
    { "id": 2, "name": "ஓம் விக்னராஜாய நம:", "meaning": "விக்னங்களை (இடைஞ்சல்களை) நீக்கும் அரசரே போற்றி" },
    { "id": 3, "name": "ஓம் கெளரி புத்ராய நம:", "meaning": "கௌரி தேவியின் மைந்தனே போற்றி" },
    { "id": 4, "name": "ஓம் கணேச்வராய நம:", "meaning": "பூத கணங்களின் ஈஸ்வரனே போற்றி" },
    { "id": 5, "name": "ஓம் ஸ்கந்தாக்ரஜாய நம:", "meaning": "முருகப் பெருமானின் மூத்த சகோதரரே போற்றி" },
    { "id": 6, "name": "ஓம் அவ்யயாய நம:", "meaning": "அழிவு இல்லாதவரே போற்றி" },
    { "id": 7, "name": "ஓம் பூதாய நம:", "meaning": "பூதங்களின் வடிவானவரே போற்றி" },
    { "id": 8, "name": "ஓம் தக்ஷாய நம:", "meaning": "சமர்த்தரே (எல்லா காரியங்களையும் திறம்பட செய்பவரே) போற்றி" },
    { "id": 9, "name": "ஓம் அத்யக்ஷாய நம:", "meaning": "அனைத்தையும் கண்காணிக்கும் தலைவரே போற்றி" },
    { "id": 10, "name": "ஓம் த்விஜப்ரியாய நம:", "meaning": "இருபிறப்பாளர்களான அந்தணர்களுக்குப் பிரியமானவரே போற்றி" },
    { "id": 11, "name": "ஓம் அக்னிகர்ப்பச்சிதே நம:", "meaning": "அக்னியைத் தன் கருவில் தாங்கியவரே போற்றி" },
    { "id": 12, "name": "ஓம் இந்த்ரஸ்ரீப்ரதாய நம:", "meaning": "இந்திரனுக்கு அவனது செல்வத்தை மீண்டும் அளித்தவரே போற்றி" },
    { "id": 13, "name": "ஓம் வாணீப்ரதாய நம:", "meaning": "சரஸ்வதி தேவிக்கு வாக்கு வன்மையையும் கலைகளையும் அருளியவரே போற்றி" },
    { "id": 14, "name": "ஓம் அவ்யயாய நம:", "meaning": "எப்போதும் மாறாத நிலைத்த தன்மை உடையவரே போற்றி" },
    { "id": 15, "name": "ஓம் ஸர்வஸித்திப்ரதாயகாய நம:", "meaning": "அனைத்து விதமான சித்தி மற்றும் வெற்றிகளைத் தருபவரே போற்றி" },
    { "id": 16, "name": "ஓம் சர்வதனயாய நம:", "meaning": "எல்லா நன்மைகளையும் வாரி வழங்குபவரே போற்றி" },
    { "id": 17, "name": "ஓம் சர்வரீப்ரியாய நம:", "meaning": "இரவு அல்லது பார்வதி தேவிக்குப் பிரியமானவரே போற்றி" },
    { "id": 18, "name": "ஓம் சர்வாத்மகாய நம:", "meaning": "அனைத்து உயிர்களிலும் ஆத்மாவாக விளங்குபவரே போற்றி" },
    { "id": 19, "name": "ஓம் ஸ்ருஷ்டிகர்த்ரே நம:", "meaning": "உலகைப் படைக்கும் தொழில் புரிபவரே போற்றி" },
    { "id": 20, "name": "ஓம் தேவாய நம:", "meaning": "ஒளி பொருந்திய தேவாதி தேவரே போற்றி" },
    { "id": 21, "name": "ஓம் அனேகார்ச்சிதாய நம:", "meaning": "பலராலும் எப்போதும் அர்ச்சிக்கப்படுபவரே போற்றி" },
    { "id": 22, "name": "ஓம் சிவாய நம:", "meaning": "மங்கள வடிவமானவரே போற்றி" },
    { "id": 23, "name": "ஓம் சுத்தாய நம:", "meaning": "பரிசுத்தமான தூய வடிவானவரே போற்றி" },
    { "id": 24, "name": "ஓம் புத்திப்பிரியாய நம:", "meaning": "அறிவை அல்லது புத்தி தேவியை விரும்புபவரே போற்றி" },
    { "id": 25, "name": "ஓம் சாந்தாய நம:", "meaning": "அமைதியான குணம் கொண்டவரே போற்றி" },
    { "id": 26, "name": "ஓம் ப்ரஹ்மசாரிணே நம:", "meaning": "நித்திய பிரம்மச்சாரியைக் கடைப்பிடிப்பவரே போற்றி" },
    { "id": 27, "name": "ஓம் கஜானனாய நம:", "meaning": "யானை முகம் கொண்டவரே போற்றி" },
    { "id": 28, "name": "ஓம் த்வைமாதுராய நம:", "meaning": "பார்வதி, மாலினி ஆகிய இரு தாயார்களை உடையவரே போற்றி" },
    { "id": 29, "name": "ஓம் முனிஸ்தuத்யாய நம:", "meaning": "முனிவர்களாலும் ரிஷிகளாலும் துதிக்கப்படுபவரே போற்றி" },
    { "id": 30, "name": "ஓம் பக்தவிக்னவிநாசனாய நம:", "meaning": "பக்தர்களின் தடைகளை வேரோடு அழிப்பவரே போற்றி" },
    { "id": 31, "name": "ஓம் ஏகதந்தாய நம:", "meaning": "ஒற்றைத் தந்தம் உடையவரே போற்றி" },
    { "id": 32, "name": "ஓம் சதுர்பாஹவே நம:", "meaning": "நான்கு திருக்கரங்களை உடையவரே போற்றி" },
    { "id": 33, "name": "ஓம் சதுராய நம:", "meaning": "மிகவும் சாதுரியம் மிக்கவரே போற்றி" },
    { "id": 34, "name": "ஓம் சக்திஸம்யுதாய நம:", "meaning": "பராசக்தியோடு இணைந்திருப்பவரே போற்றி" },
    { "id": 35, "name": "ஓம் லம்போதராய நம:", "meaning": "பெரிய தொந்தியை உடையவரே போற்றி" },
    { "id": 36, "name": "ஓம் சூர்ப்பகர்ணாய நம:", "meaning": "முறம் போன்ற பெரிய காதுகளை உடையவரே போற்றி" },
    { "id": 37, "name": "ஓம் ஹரயே நம:", "meaning": "பாவங்களைப் போக்குபவரே போற்றி" },
    { "id": 38, "name": "ஓம் ப்ரஹ்மவிதுத்தமாய நம:", "meaning": "பிரம்மத்தை அறிந்தவர்களில் முதன்மையானவரே போற்றி" },
    { "id": 39, "name": "ஓம் காலாய நம:", "meaning": "காலத்தின் வடிவமாக இருப்பவரே போற்றி" },
    { "id": 40, "name": "ஓம் க்ரஹபதயே நம:", "meaning": "நவகிரகங்களின் தலைவரே போற்றி" },
    { "id": 41, "name": "ஓம் காமினே நம:", "meaning": "பக்தர்கள் விரும்பும் நன்மைகளைத் தருபவரே போற்றி" },
    { "id": 42, "name": "ஓம் ஸோமஸூர்யாக்னிலோசனாய நம:", "meaning": "சந்திரன், சூரியன், அக்னி ஆகிய மூவரையும் கண்களாகக் கொண்டவரே போற்றி" },
    { "id": 43, "name": "ஓம் பாசாங்குசதராய நம:", "meaning": "பாசம், அங்குசம் ஆகிய ஆயுதங்களைத் தரித்தவரே போற்றி" },
    { "id": 44, "name": "ஓம் சண்டாய நம:", "meaning": "தீயவர்களுக்குக் கோபக்கனலாய் விளங்குபவரே போற்றி" },
    { "id": 45, "name": "ஓம் குணாதீதாய நம:", "meaning": "முக்குணங்களையும் (சத்வம், ரஜஸ், தமஸ்) கடந்தவரே போற்றி" },
    { "id": 46, "name": "ஓம் நிரஞ்ஜநாய நம:", "meaning": "எந்தக் குறையும் அல்லது பற்றும் இல்லாத மாசற்றவரே போற்றி" },
    { "id": 47, "name": "ஓம் அகல்மஷாய நம:", "meaning": "பாவங்கள் அற்றவரே போற்றி" },
    { "id": 48, "name": "ஓம் ஸ்வயம்ஸித்தாய நம:", "meaning": "தானாகவே சித்தி பெற்ற சுயம்பு வடிவானவரே போற்றி" },
    { "id": 49, "name": "ஓம் ஸித்தார்ச்சிதபதாம்புஜாய நம:", "meaning": "சித்தர்களால் அர்ச்சிக்கப்பட்ட தாமரை போன்ற திருவடிகளை உடையவரே போற்றி" },
    { "id": 50, "name": "ஓம் பீஜாபூரபலாஸக்தாய நம:", "meaning": "மாதுளம் பழத்தை விரும்பி ஏற்பவரே போற்றி" },
    { "id": 51, "name": "ஓம் வரதாய நம:", "meaning": "கேட்கும் வரங்களை அருளுபவரே போற்றி" },
    { "id": 52, "name": "ஓம் சாச்வதாய நம:", "meaning": "என்றென்றும் நிலைத்திருப்பவரே போற்றி" },
    { "id": 53, "name": "ஓம் க்ருதினே நம:", "meaning": "செயல் வடிவானவரே போற்றி" },
    { "id": 54, "name": "ஓம் த்விஜப்ரியாய நம:", "meaning": "வேதியர்களால் போற்றப்படுபவரே போற்றி" },
    { "id": 55, "name": "ஓம் வீதபயாய நம:", "meaning": "பயம் என்பது சற்றும் இல்லாதவரே போற்றி" },
    { "id": 56, "name": "ஓம் கதாதராய நம:", "meaning": "கதை என்னும் ஆயுதத்தைத் தாங்கியவரே போற்றி" },
    { "id": 57, "name": "ஓம் இக்ஷுசாபதராய நம:", "meaning": "கரும்பு வில்லைத் தரித்தவரே போற்றி" },
    { "id": 58, "name": "ஓம் அஜாய நம:", "meaning": "பிறப்பில்லாதவரே போற்றி" },
    { "id": 59, "name": "ஓம் ஸ்ரீதயே நம:", "meaning": "செல்வங்களை அள்ளித் தருபவரே போற்றி" },
    { "id": 60, "name": "ஓம் விபுதேச்வராய நம:", "meaning": "தேவர்களின் ஈஸ்வரனே போற்றி" },
    { "id": 61, "name": "ஓம் மஹோதராய நம:", "meaning": "பெரிய வயிற்றை உடையவரே போற்றி" },
    { "id": 62, "name": "ஓம் ஸ்தூலதுண்டாய நம:", "meaning": "பெரிய தும்பிக்கையை உடையவரே போற்றி" },
    { "id": 63, "name": "ஓம் அக்ரணே நம:", "meaning": "அனைத்திலும் முதன்மையாக விளங்குபவரே போற்றி" },
    { "id": 64, "name": "ஓம் யோகாதீபாய நம:", "meaning": "யோகிகளின் மனதை ஒளிரச் செய்யும் தீபமே போற்றி" },
    { "id": 65, "name": "ஓம் ஸ்தூலாய நம:", "meaning": "விஸ்வரூப பிரம்மாண்ட வடிவினரே போற்றி" },
    { "id": 66, "name": "ஓம் லம்பகர்ணாய நம:", "meaning": "நீண்ட காதுகளைக் கொண்டவரே போற்றி" },
    { "id": 67, "name": "ஓம் ஜடிலாய நம:", "meaning": "சடாமுடி தரித்தவரே போற்றி" },
    { "id": 68, "name": "ஓம் கலிகல்மஷநாசனாய நம:", "meaning": "கலியுகத்தின் பாவங்களை நாசம் செய்பவரே போற்றி" },
    { "id": 69, "name": "ஓம் ஜகத்காரணாய நம:", "meaning": "உலகம் தோன்றுவதற்குக் காரணமானவரே போற்றி" },
    { "id": 70, "name": "ஓம் விக்னஹர்த்ரே நம:", "meaning": "இடையூறுகளைத் தவிடுபொடியாக்குபவரே போற்றி" },
    { "id": 71, "name": "ஓம் த்ரிவிக்ரமாய நம:", "meaning": "மூவுலகையும் அளந்த விஷ்ணுவின் ஆற்றல் கொண்டவரே போற்றி" },
    { "id": 72, "name": "ஓம் கஞ்ஜலோசனாய நம:", "meaning": "தாமரை போன்ற கண்களை உடையவரே போற்றி" },
    { "id": 73, "name": "ஓம் த்ராஸப்ரம்ஹணே நம:", "meaning": "அச்சத்தைப் போக்குபவரே போற்றி" },
    { "id": 74, "name": "ஓம் அவ்யகதாலக்ஷணாய நம:", "meaning": "புலன்களுக்குப் புலப்படாத தெய்வீகக் குறியீடுகளை உடையவரே போற்றி" },
    { "id": 75, "name": "ஓம் ப்ரமதாய நம:", "meaning": "மகிழ்ச்சியைத் தருபவரே போற்றி" },
